{#- The Model tab's content. The current week embeds it, and its build also writes it to the site root as model.html,
    which every other week's page (archived and lookahead) loads into its own Model tab (gamecast.js), so the model
    description is the same, current one everywhere. -#}
{% if model_doc.stale %}<div class="stale">This description may be out of date: the model code or configuration changed after it was last reviewed.</div>{% endif %}
<div class="doc-layout">
  <nav class="toc">{% for h in model_doc.toc %}<a href="#{{ h.id }}">{{ h.title }}</a>{% endfor %}{% if track %}<a href="#track-record">How often favorites win</a>{% endif %}</nav>
  <article class="card card-pad doc">{{ model_doc.html|safe }}
    {% if track %}<h2 id="track-record">How often favorites win</h2>
    <p>Market chances, {{ track.since }}&ndash;{{ track.season }}. A well-calibrated forecast's favorites win about as often as their chance says; each season is scored with chances fit only on the seasons before it.</p>
    <table class="trk"><thead><tr><th>Favorite's chance</th><th class="num">Games</th><th class="num">Expected</th><th class="num">Won</th><th class="num">{{ track.season }}</th></tr></thead>
    <tbody>{% for r in track.rows %}<tr{% if r.tossup %} class="toss"{% endif %}><td>{{ r.label }}</td><td class="num">{{ r.n }}</td><td class="num">{{ '%.0f'|format(r.expected) }}%</td><td class="num"><b>{{ '%.0f'|format(r.actual) }}%</b></td><td class="num">{% if r.n_now %}{{ '%.0f'|format(r.actual_now) }}% <small>of {{ r.n_now }}</small>{% else %}&ndash;{% endif %}</td></tr>{% endfor %}</tbody></table>{% endif %}
  </article>
</div>

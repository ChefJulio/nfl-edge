<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NFL Edge · Week {{ week }}</title>
<style>
:root {
  --bg: #f5f6f8; --panel: #ffffff; --panel2: #f9fafb; --ink: #14161a; --muted: #6a717c; --faint: #9aa1ab;
  --line: #e6e8ec; --accent: #2f6fed; --good: #16803c; --bad: #c2372c; --warn: #9a6700;
  --shadow: 0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06);
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #0d0f13; --panel: #15181d; --panel2: #1a1e24; --ink: #e9ecf0; --muted: #98a0ab; --faint: #6b737e;
          --line: #262b33; --accent: #6d9eff; --good: #45c26b; --bad: #f2786d; --warn: #e0b04a;
          --shadow: 0 1px 2px rgba(0,0,0,.4); }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.45 Inter, "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, "Helvetica Neue", sans-serif;
       font-feature-settings: "tnum" 1, "cv11" 1; -webkit-font-smoothing: antialiased; }
a { color: var(--accent); }
.wrap { max-width: 1440px; margin: 0 auto; padding: 0 20px; }
@media (max-width: 640px) { .wrap { padding: 0 16px; } }

/* header + nav */
header.top { padding: 22px 0 14px; }
.brand { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
.brand h1 { font-size: 22px; font-weight: 800; letter-spacing: -.02em; margin: 0; }
.brand h1 span { color: var(--accent); }
.brand .wk { font-size: 15px; color: var(--muted); font-weight: 500; }
.meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
.meta span { font-size: 12px; color: var(--muted); background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; }
.meta span b { color: var(--ink); font-weight: 600; }
.meta span.alert { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, var(--line)); }
nav.tabs { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
nav.tabs .wrap { display: flex; gap: 22px; overflow-x: auto; scrollbar-width: none; }
nav.tabs button { flex: none; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); font: inherit; font-weight: 600; font-size: 13.5px; padding: 12px 0 10px; cursor: pointer; }
nav.tabs button:hover { color: var(--ink); }
nav.tabs button.on { color: var(--ink); border-bottom-color: var(--accent); }
main { padding: 20px 0 48px; }
section { display: none; } section.on { display: block; }

/* section chrome */
.sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
.sec-head h2 { font-size: 18px; font-weight: 700; letter-spacing: -.01em; margin: 0; }
.sec-head p { margin: 2px 0 0; color: var(--muted); font-size: 13px; }
details.howto { margin: 0 0 14px; }
details.howto summary { cursor: pointer; color: var(--muted); font-size: 12.5px; list-style: none; display: inline-flex; align-items: center; gap: 6px; }
details.howto summary::before { content: "i"; display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--faint); font-size: 10px; font-weight: 700; }
details.howto[open] summary { color: var(--ink); }
details.howto div { margin-top: 8px; color: var(--muted); font-size: 12.5px; max-width: 900px; line-height: 1.55; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); }
.card + .card { margin-top: 18px; }
.card-pad { padding: 16px; }

/* toolbar */
.toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; padding: 12px 14px; border-bottom: 1px solid var(--line); }
.seg { display: inline-flex; background: var(--panel2); border: 1px solid var(--line); border-radius: 8px; padding: 2px; }
.seg button { background: none; border: 0; color: var(--muted); font: inherit; font-weight: 600; font-size: 13px; padding: 5px 14px; border-radius: 6px; cursor: pointer; }
.seg button.on { background: var(--panel); color: var(--ink); box-shadow: var(--shadow); }
#psearch { flex: 1; min-width: 150px; max-width: 280px; padding: 7px 11px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel2); color: var(--ink); font: inherit; font-size: 13px; }
#psearch:focus { outline: 2px solid color-mix(in srgb, var(--accent) 40%, transparent); border-color: var(--accent); }

/* tables */
.scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th, td { padding: 8px 10px; text-align: left; white-space: nowrap; vertical-align: middle; }
thead th.can-sort { cursor: pointer; } thead th.can-sort:hover { color: var(--ink); }
thead th.nosort { cursor: default; }
thead th.sorted-asc::after { content: " \25B2"; font-size: 8px; color: var(--accent); }
thead th.sorted-desc::after { content: " \25BC"; font-size: 8px; color: var(--accent); }
thead th { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); background: var(--panel); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 2; user-select: none; }
tbody td { border-bottom: 1px solid var(--line); }
td.num, th.num { text-align: right; }
abbr { text-decoration: none; border-bottom: 1px dotted var(--faint); cursor: help; }
.muted { color: var(--muted); } .quiet { color: color-mix(in srgb, currentColor 72%, transparent); }
@media (max-width: 760px) { .hide-sm { display: none; } }

/* team rows: background = team primary; text = team secondary if it meets WCAG 4.5:1 on the primary, else white/black.
   Meaningful colors (grades, risk, tiers, badges) sit on light pills so they read on any team color. */
table.tiles { border-collapse: separate; border-spacing: 0 3px; margin-top: -3px; }
table.tiles thead th { border-bottom: 0; }
tr.teamrow { position: relative; }
tr.teamrow > td { background: #171a20; color: #fff; border: 0; }
tr.teamrow > td:first-child { border-radius: 6px 0 0 6px; }
tr.teamrow > td:last-child { border-radius: 0 6px 6px 0; }
/* Team trim: 2px primary-color border around the row, secondary-color notches centered on each side.
   One pseudo-element only: a ::before on a table row would be laid out as an extra cell and shift the columns. */
tr.teamrow::after { content: ""; position: absolute; inset: 0; border-radius: 6px; pointer-events: none; z-index: 4;
  border: 2px solid var(--tc);
  background: linear-gradient(var(--tc2), var(--tc2)) left center / 4px 42% no-repeat border-box,
              linear-gradient(var(--tc2), var(--tc2)) right center / 4px 42% no-repeat border-box; }
tr.teamrow:hover > td { background: #1e222a; }
tr.teamrow .quiet, tr.teamrow .sub, tr.teamrow .st small, tr.teamrow .fc, tr.teamrow .vs { color: color-mix(in srgb, var(--tfg) 75%, transparent); }
tr.teamrow.boosted > td:first-child { box-shadow: inset 3px 0 0 #ffd84d; }
tr.teamrow.out > td { color: rgba(255,255,255,.55); }
.logo { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; flex: none; box-shadow: 0 0 0 1px rgba(255,255,255,.18); }
.logo img { width: 18px; height: 18px; object-fit: contain; }
.who { display: flex; align-items: center; gap: 9px; }
.who b { font-weight: 600; }
.who .sub { font-size: 11px; display: block; line-height: 1.2; font-weight: 500; }
.chip { display: inline-block; min-width: 40px; text-align: center; font-size: 11px; font-weight: 700; letter-spacing: .03em; padding: 2px 6px; border-radius: 5px; border-left: 3px solid; box-shadow: 0 0 0 1px rgba(255,255,255,.5); }
.pill { display: inline-block; padding: 0 7px; border-radius: 999px; font-weight: 700; font-size: 11.5px; line-height: 19px; background: #eef0f3; color: #2a2f37; white-space: nowrap; }
.pill-good { background: #dcf2e3; color: #10612a; } .pill-bad { background: #fde1dd; color: #9b2218; }
.pill-warn { background: #fdefc6; color: #7a5200; } .pill-soft { background: #eef0f3; color: #3a3f47; }
.pill-strong { background: var(--accent); color: #fff; }
.g { display: inline-block; width: 20px; text-align: center; border-radius: 5px; font-weight: 800; font-size: 11.5px; line-height: 19px; background: #eef0f3; color: #2a2f37; }
.g-A { background: #c9ecd4; color: #0c5222; } .g-B { background: #e3f4e8; color: #1e7a3a; } .g-D { background: #fdebe9; color: #a8352a; } .g-F { background: #f9d3ce; color: #8a1d14; }
.tier { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 0 8px; border-radius: 999px; line-height: 20px; background: #eef0f3; color: #3a3f47; }
.t-Must { background: #16803c; color: #fff; } .t-Start { background: #dcf2e3; color: #10612a; } .t-Flex { background: #fdefc6; color: #7a5200; }
.flag { display: inline-block; font-size: 10.5px; font-weight: 600; padding: 0 6px; border-radius: 4px; line-height: 17px; background: rgba(255,255,255,.92); color: #1d1f23; white-space: nowrap; }
.f-q { background: #fdefc6; color: #7a5200; } .f-out { background: #fde1dd; color: #9b2218; } .f-up { background: #dcf2e3; color: #10612a; }

/* rankings */
table.ranks td.stick, table.ranks th.stick { position: sticky; left: 0; z-index: 1; min-width: 190px; white-space: normal; }
table.ranks thead th.stick { z-index: 3; }
.badges { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 3px; }
td.rk { font-weight: 700; width: 32px; }
td.ecr { color: color-mix(in srgb, var(--tfg, var(--ink)) 82%, transparent); }
td.ecr.stale { font-style: italic; color: color-mix(in srgb, var(--tfg, var(--ink)) 58%, transparent); } td.ecr sup { font-size: 8px; margin-left: 1px; font-style: normal; }
td.mu { white-space: nowrap; } td.mu .vs { font-size: 11px; margin-right: 5px; }
td.mu .g { margin-left: 8px; } td.mu .pill { margin-left: 4px; }
.proj { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
.proj b { min-width: 36px; text-align: right; font-size: 15px; font-weight: 700; }
.fc { font-size: 11px; min-width: 38px; text-align: left; }
.rng .rng-w { stroke: var(--tfg, var(--muted)); stroke-width: 1.5; opacity: .6; }
.rng .rng-b { fill: var(--tfg, var(--accent)); opacity: .45; }
.rng .rng-p { stroke: var(--tfg, var(--ink)); stroke-width: 2.2; }
td.line { min-width: 280px; }
.xl { display: flex; align-items: center; gap: 12px; }
.xl-st { display: flex; flex-wrap: nowrap; gap: 9px; }
.xl-td { display: flex; gap: 6px; }
.st { display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; }
.st b { font-weight: 600; } .st small { font-size: 10.5px; }
.tdd { display: inline-flex; flex-direction: column; align-items: center; cursor: help; }
.tdd small { font-size: 9px; margin-top: -1px; white-space: nowrap; opacity: .8; }
.tdd .td0 { stroke: var(--tfg, var(--muted)); opacity: .18; } .tdd .td1 { stroke: var(--tfg, var(--accent)); opacity: .45; }
.tdd .td2 { stroke: var(--tfg, var(--accent)); opacity: .72; } .tdd .td3 { stroke: var(--tfg, var(--accent)); }
.tdd .tdc { font-size: 9.5px; font-weight: 700; text-anchor: middle; fill: var(--tfg, var(--ink)); }
td.take { white-space: normal; min-width: 180px; max-width: 250px; font-weight: 600; line-height: 1.35; }
tr.main { cursor: pointer; }
tr.detail td { background: var(--panel2); white-space: normal; border-radius: 6px; }
.dgrid { display: grid; grid-template-columns: 1fr; gap: 14px; padding: 6px 4px; }
@media (min-width: 900px) { .dgrid { grid-template-columns: 1.1fr 1.5fr auto; } }
.dh { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 4px; font-weight: 600; }
.dgrid .line { display: flex; flex-wrap: wrap; gap: 4px 10px; }
.small { font-size: 12px; }
.wbars .wb { fill: var(--accent); } .wbars .wb-miss { stroke: var(--faint); stroke-width: 1.5; }
.wbars .wb-l { font-size: 8px; fill: var(--muted); text-anchor: middle; }
.byes { padding: 12px 14px; font-size: 12.5px; display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; border-top: 1px solid var(--line); color: var(--muted); }
.byes .bye { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); }
.byes .logo { width: 20px; height: 20px; } .byes .logo img { width: 15px; height: 15px; }

/* diverging bars */
.dbar { position: relative; display: inline-block; height: 8px; border-radius: 4px; background: color-mix(in srgb, var(--muted) 16%, transparent); vertical-align: middle; }
.dbar-mid { position: absolute; left: 50%; top: -2px; bottom: -2px; width: 1px; background: var(--faint); }
.dbar-fill { position: absolute; top: 0; bottom: 0; border-radius: 4px; }
.dbar-fill.pos { background: var(--good); } .dbar-fill.neg { background: var(--bad); }
tr.teamrow .dbar { background: rgba(255,255,255,.12); } tr.teamrow .dbar-mid { background: rgba(255,255,255,.5); }
tr.teamrow .dbar-fill.pos { background: #45c26b; } tr.teamrow .dbar-fill.neg { background: #f2786d; }
.spark { color: var(--accent); vertical-align: middle; } tr.teamrow .spark { color: #8fb4ff; }
.valbar { display: inline-flex; align-items: center; gap: 8px; justify-content: flex-end; }
.valbar b { min-width: 42px; text-align: right; }

/* matchups */
.games { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 980px) { .games { grid-template-columns: 1fr 1fr; } }
.game { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
.g-head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
.g-team { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: var(--tc); color: var(--tfg); min-height: 62px; }
.g-team.home { flex-direction: row-reverse; text-align: right; }
.g-team .logo { width: 34px; height: 34px; } .g-team .logo img { width: 26px; height: 26px; }
.g-team b { font-size: 15px; font-weight: 700; display: block; line-height: 1.15; }
.g-team small { font-size: 11.5px; opacity: .8; }
.g-at { padding: 0 10px; font-size: 12px; font-weight: 700; color: var(--muted); background: var(--panel); align-self: stretch; display: grid; place-items: center; }
.g-sub { display: flex; justify-content: space-between; gap: 8px; font-size: 11.5px; color: var(--muted); padding: 8px 16px 0; }
.g-lines { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 16px 6px; }
.lb { border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; background: var(--panel2); }
.lb small { display: block; font-size: 10.5px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 700; margin-bottom: 2px; }
.lb .big { font-size: 21px; font-weight: 800; letter-spacing: -.01em; line-height: 1.15; }
.lb .tot { font-size: 13px; color: var(--muted); font-weight: 600; margin-top: 1px; }
.lb .tot b { color: var(--ink); }
.lb.model { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); background: color-mix(in srgb, var(--accent) 7%, var(--panel)); }
.lb.model small { color: var(--accent); }
.edges { display: flex; gap: 6px; flex-wrap: wrap; padding: 4px 16px 4px; min-height: 26px; align-items: center; }
.edge { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink); }
.edge b { font-weight: 800; }
.edge.strong { background: var(--accent); border-color: var(--accent); color: #fff; }
.edge.none { color: var(--muted); border-style: dashed; }
.facets { padding: 6px 16px 12px; display: grid; gap: 5px; }
.facet { display: grid; grid-template-columns: 22px 1fr 128px 44px; align-items: center; gap: 8px; font-size: 12px; }
.facet .logo { width: 20px; height: 20px; } .facet .logo img { width: 15px; height: 15px; }
.facet .lbl { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.facet .v { text-align: right; font-weight: 700; }
.facet-axis { display: grid; grid-template-columns: 22px 1fr 128px 44px; gap: 8px; font-size: 10px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; }
.facet-axis span:nth-child(3) { display: flex; justify-content: space-between; }
.game details { border-top: 1px solid var(--line); }
.game details summary { cursor: pointer; padding: 9px 16px; font-size: 12px; color: var(--muted); font-weight: 600; list-style: none; }
.game details summary::after { content: " +"; } .game details[open] summary::after { content: " -"; }
.game details table { font-size: 12px; } .game details td, .game details th { padding: 6px 12px; }

/* misc */
.arrow { display: inline-flex; align-items: center; gap: 6px; }
.arrow .from { opacity: .7; } .arrow i { font-style: normal; opacity: .6; }
.best { font-weight: 800; color: var(--accent); }
.bt-group { text-align: center !important; border-bottom: 0 !important; }
/* matchup cell: opponent, 5-segment grade meter, points vs an average defense */
.mu-row { display: flex; align-items: center; gap: 10px; }
.opp { display: inline-flex; align-items: center; gap: 6px; min-width: 72px; }
.opp .vs { font-size: 11px; width: 16px; color: rgba(255,255,255,.55); }
.opp .logo { width: 20px; height: 20px; } .opp .logo img { width: 15px; height: 15px; }
.opp b { font-weight: 700; font-size: 12.5px; letter-spacing: .02em; }
.meter { display: inline-flex; gap: 2px; align-items: flex-end; cursor: help; }
.meter i { width: 4px; height: 12px; border-radius: 1.5px; background: rgba(255,255,255,.13); }
.meter.m5 i.on, .meter.m4 i.on { background: #54d17a; } .meter.m3 i.on { background: rgba(255,255,255,.62); }
.meter.m2 i.on, .meter.m1 i.on { background: #ff8378; }
.dvp { font-size: 12.5px; font-weight: 700; min-width: 34px; cursor: help; }
/* translucent chips on dark tiles (light pills glare on dark rows) */
tr.teamrow .pill { background: rgba(255,255,255,.08); color: rgba(255,255,255,.82); }
tr.teamrow .pill-good { background: rgba(69,194,107,.17); color: #8fe6a9; }
tr.teamrow .pill-bad { background: rgba(242,120,109,.18); color: #ffaaa1; }
tr.teamrow .pill-warn { background: rgba(224,176,74,.17); color: #f3d38c; }
tr.teamrow .tier { background: rgba(255,255,255,.07); color: rgba(255,255,255,.65); font-weight: 600; }
tr.teamrow .t-Must { background: rgba(69,194,107,.3); color: #b2f1c4; } tr.teamrow .t-Start { background: rgba(69,194,107,.14); color: #c3ebcf; }
tr.teamrow .t-Flex { background: rgba(224,176,74,.16); color: #f3d38c; }
tr.teamrow .flag { background: rgba(255,255,255,.1); color: rgba(255,255,255,.85); }
tr.teamrow .f-q { background: rgba(224,176,74,.18); color: #f3d38c; } tr.teamrow .f-out { background: rgba(242,120,109,.2); color: #ffaaa1; }
tr.teamrow .f-up { background: rgba(69,194,107,.18); color: #8fe6a9; }
/* position badges: one color per position everywhere */
:root { --qb: #ff6f91; --rb: #34d399; --wr: #60a5fa; --te: #fbbf24; }
.posb { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .04em; padding: 0 5px; border-radius: 4px; line-height: 16px; margin-right: 3px; vertical-align: 1px; }
.posb-QB { background: color-mix(in srgb, var(--qb) 20%, transparent); color: var(--qb); }
.posb-RB { background: color-mix(in srgb, var(--rb) 20%, transparent); color: var(--rb); }
.posb-WR { background: color-mix(in srgb, var(--wr) 20%, transparent); color: var(--wr); }
.posb-TE { background: color-mix(in srgb, var(--te) 20%, transparent); color: var(--te); }
.seg button.pos-QB { color: var(--qb); } .seg button.pos-RB { color: var(--rb); }
.seg button.pos-WR { color: var(--wr); } .seg button.pos-TE { color: var(--te); }
.seg button.pos-QB.on { background: color-mix(in srgb, var(--qb) 20%, var(--panel)); }
.seg button.pos-RB.on { background: color-mix(in srgb, var(--rb) 20%, var(--panel)); }
.seg button.pos-WR.on { background: color-mix(in srgb, var(--wr) 20%, var(--panel)); }
.seg button.pos-TE.on { background: color-mix(in srgb, var(--te) 20%, var(--panel)); }
@media (prefers-color-scheme: light) { :root { --qb: #d6336c; --rb: #0f9f6e; --wr: #2563eb; --te: #b7791f; } }
/* power */
table.power td { padding-top: 9px; padding-bottom: 9px; }
table.power .rk { width: 46px; }
.rkn { font-size: 15px; font-weight: 800; display: block; line-height: 1.1; }
.mv { display: block; font-size: 10px; font-weight: 700; color: rgba(255,255,255,.45); line-height: 1.2; }
.mv.up { color: #6fdc8c; } .mv.dn { color: #ff8f84; }
.netc b { font-size: 17px; font-weight: 800; display: block; line-height: 1.1; }
.mc { display: flex; align-items: center; gap: 7px; }
.mv2 { font-weight: 700; font-size: 14px; min-width: 38px; }
.rk-b { display: inline-block; min-width: 34px; text-align: center; font-size: 10.5px; font-weight: 700; border-radius: 4px; padding: 0 5px; line-height: 17px; }
.rk1 { background: rgba(69,194,107,.24); color: #92e8ab; } .rk2 { background: rgba(69,194,107,.11); color: #c4ecd0; }
.rk3 { background: rgba(224,176,74,.14); color: #f1d391; } .rk4 { background: rgba(242,120,109,.2); color: #ffb3aa; }
.rkn2 { background: rgba(255,255,255,.1); color: rgba(255,255,255,.85); }
.mv3 { font-weight: 600; font-size: 12.5px; min-width: 32px; color: rgba(255,255,255,.88); }
.rk-b.sm { min-width: 30px; font-size: 9.5px; line-height: 15px; padding: 0 4px; opacity: .92; }
table.power th.minor { font-size: 10px; } table.power td.minor { padding-left: 6px; padding-right: 6px; }
table.power .mc { gap: 5px; }
tr.teamrow .sub { color: rgba(255,255,255,.62); }
table.power .sub { display: block; margin-top: 2px; font-size: 11px; }
/* model doc */
.doc-layout { display: grid; grid-template-columns: 1fr; gap: 20px; }
@media (min-width: 1100px) { .doc-layout { grid-template-columns: 220px minmax(0, 1fr); } }
.toc { display: none; }
@media (min-width: 1100px) { .toc { display: flex; flex-direction: column; gap: 2px; position: sticky; top: 64px; align-self: start; }
  .toc a { color: var(--muted); text-decoration: none; font-size: 13px; padding: 5px 10px; border-left: 2px solid var(--line); }
  .toc a:hover { color: var(--ink); border-left-color: var(--accent); } }
.doc { max-width: 920px; line-height: 1.65; font-size: 14.5px; padding: 26px 30px; }
.doc h1 { display: none; }
.doc h2 { font-size: 18px; margin: 30px 0 10px; padding-top: 6px; letter-spacing: -.01em; scroll-margin-top: 70px; }
.doc h2:first-of-type { margin-top: 18px; }
.doc p, .doc li { color: color-mix(in srgb, var(--ink) 88%, transparent); }
.doc ul, .doc ol { padding-left: 20px; } .doc li { margin: 6px 0; }
.doc blockquote { margin: 12px 0; padding: 10px 16px; border-left: 3px solid var(--accent); background: var(--panel2); border-radius: 0 8px 8px 0; font-weight: 600; }
.doc blockquote p { margin: 0; }
.doc table { margin: 12px 0; font-size: 13px; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.doc th { position: static; text-transform: none; letter-spacing: 0; font-size: 12.5px; background: var(--panel2); color: var(--ink); cursor: default; }
.doc td { white-space: normal; }
.doc code { font: 12.5px ui-monospace, SFMono-Regular, Consolas, monospace; background: var(--panel2); padding: 1px 5px; border-radius: 4px; }
.doc .live { color: var(--accent); font-weight: 700; }
.doc p > code:only-child { display: block; padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; white-space: pre-wrap; line-height: 1.6; font-size: 12.5px; }
.doc h3 { font-size: 15px; margin: 28px 0 8px; letter-spacing: -.01em; }
.doc table { display: block; overflow-x: auto; width: fit-content; max-width: 100%; }
.doc td, .doc th { padding: 6px 12px; font-variant-numeric: tabular-nums; }
.doc tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--panel2) 60%, transparent); }
.stale { margin: 0 0 14px; padding: 10px 14px; border-radius: 10px; border: 1px solid color-mix(in srgb, var(--warn) 50%, var(--line)); color: var(--warn); background: color-mix(in srgb, var(--warn) 8%, var(--panel)); font-size: 13px; font-weight: 600; }
footer { color: var(--faint); font-size: 12px; padding: 0 0 36px; }
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <div class="brand"><h1>NFL <span>Edge</span></h1><div class="wk">{{ season }} &middot; Week {{ week }}</div></div>
  <div class="meta">
    <span>Data through <b>week {{ week - 1 }}</b>{% if pending %} &middot; {{ pending }} game pending{% endif %}</span>
    <span>Scoring <b>{{ 'Half PPR' if scoring == 'half' else scoring|upper if scoring in ('ppr',) else scoring|capitalize }}</b></span>
    {% if not injury_report %}<span class="alert">Injury report not out yet &middot; using last week's statuses</span>{% else %}<span>Injury report <b>in</b></span>{% endif %}
    <span>Updated {{ generated }}</span>
  </div>
</div></header>
<nav class="tabs"><div class="wrap">
  <button data-tab="players" class="on">Rankings</button>
  <button data-tab="games">Matchups</button>
  <button data-tab="power">Power</button>
  <button data-tab="luck">Schedule luck</button>
  <button data-tab="roles">Role changes</button>
  <button data-tab="model">Model</button>
</div></nav>
<main><div class="wrap">

<section id="tab-players" class="on">
  <div class="sec-head"><div><h2>Weekly rankings</h2><p>Half-PPR projections if active, with realistic ranges. Tap a player for season stats.</p></div></div>
  <details class="howto"><summary>How to read</summary><div>
    <b>Projection</b> assumes the player is active (NFL availability is yes/no, so injured players show an Inactive% instead of a discount).
    The <b>range bar</b> comes from how past projections of this size actually turned out: thin line = floor to ceiling (10th to 90th percentile), thick bar = the likely middle half, tick = projection.
    <b>Matchup</b>: grade A-F ranks this week's matchups at the position; the pill is fantasy points this defense adds or removes vs an average one.
    <b>TD donut</b>: ring segments = chance of 0 / 1 / 2 / 3+ touchdowns (darker = more), center = chance of at least one.
    <b>ECR</b> is the FantasyPros expert consensus rank (faded "lw" = last week's, until Friday). A yellow edge marks a projection boosted by a teammate's absence.
  </div></details>
  <div class="card">
    <div class="toolbar">
      <div class="seg posbar">{% for pos in ["QB","RB","WR","TE"] %}<button data-pos="{{ pos }}" class="pos-{{ pos }}{{ ' on' if loop.first }}">{{ pos }}</button>{% endfor %}</div>
      <input type="search" id="psearch" placeholder="Find a player" aria-label="Find a player">
    </div>
    {% for pos, block in players.items() %}
    <div class="posview" data-pos="{{ pos }}" {% if not loop.first %}hidden{% endif %}>
    <div class="scroll">
    <table class="sortable ranks tiles">
      <thead><tr>
        <th class="num" data-first="asc">#</th>
        <th class="num" data-first="asc"><abbr title="FantasyPros expert consensus rank (Fridays); faded 'lw' = last week's">ECR</abbr></th>
        <th class="stick" data-first="asc">Player</th>
        <th data-first="desc"><abbr title="Opponent and its defense vs {{ pos }}s: 1st = toughest (red), 32nd = easiest (green). Opponent-adjusted, from the model.">Matchup</abbr></th>
        <th class="num"><abbr title="Chance he is inactive: injury (practice pattern + game status) or healthy scratch">Inactive</abbr></th>
        <th class="num"><abbr title="Projection; bar = floor to ceiling (10th-90th pct), thick = middle 50%">Projection</abbr></th>
        <th class="num"><abbr title="Season fantasy points per game">FP/G</abbr></th>
        <th data-first="asc">Tier</th>
        <th class="hide-sm nosort"><abbr title="Projected stat line; donut = touchdown odds">Expected line</abbr></th>
        <th class="nosort">Takeaway</th>
      </tr></thead>
      <tbody>
      {% for r in block.rows %}
        <tr class="main teamrow{% if r.boost >= 1 %} boosted{% endif %}{% if r.avail < 0.5 %} out{% endif %}" style="{{ r.row_style }}" data-name="{{ r.name|lower }}">
          <td class="num rk">{{ r.rank }}</td>
          <td data-v="{{ r.ecr|f0 }}" class="num ecr{{ ' stale' if r.ecr_stale }}"{% if r.ecr_stale %} title="Last week's expert rank; this week's is published Friday"{% endif %}>{{ r.ecr|f0 }}{% if r.ecr_stale %}<sup>lw</sup>{% endif %}</td>
          <td class="stick" data-v="{{ r.name }}"><div class="who">{{ r.logo|safe }}<div><b>{{ r.name }}</b>
            {%- if r.status or r.boost >= 1 or r.low_sample %}<div class="badges">
              {%- if r.status %}<span class="flag {{ 'f-out' if r.avail < 0.5 else 'f-q' }}" title="Injury report; practice Wed/Thu/Fri: D = did not practice, L = limited, F = full">{{ r.status }}</span>{% endif %}
              {%- if r.boost >= 1 %}<span class="flag f-up" title="Raised by volume vacated by: {{ r.boost_from }}">+{{ r.boost|f1 }} inj</span>{% endif %}
              {%- if r.low_sample %}<span class="flag" title="Few career opportunities: efficiency leans on the position x draft-round prior">low data</span>{% endif %}
            </div>{% endif %}</div></div></td>
          {% set lvl = {'A': 5, 'B': 4, 'C': 3, 'D': 2, 'F': 1}[r.grade] %}
          <td class="mu" data-v="{{ r.dvp_rank }}"><div class="mu-row">
            <span class="opp"><span class="vs">{{ r.home }}</span>{{ r.opp_logo|safe }}<b>{{ r.opp }}</b></span>
            <span class="meter m{{ lvl }}" title="Matchup {{ r.grade }}: {{ r.opp }} is {{ r.dvp }} of 32 vs {{ pos }}s">{% for i in range(5) %}<i class="{{ 'on' if i < lvl }}"></i>{% endfor %}</span>
            <span class="dvp" style="color:{{ r.dvp_color }}" title="{{ r.opp }} defense vs {{ pos }}s: {{ r.dvp }} of 32 (1st = toughest, 32nd = easiest). This week: {{ r.mpts|sgn }} pts vs an average defense.">{{ r.dvp }}</span>
          </div></td>
          <td class="num" data-v="{{ r.inactive }}" title="{{ r.inactive_why }}"><span class="{{ 'pill pill-bad' if r.inactive >= 0.5 else 'pill pill-warn' if r.inactive >= 0.15 else 'pill pill-soft' if r.inactive >= 0.05 else 'quiet' }}">{{ '<1%' if r.inactive < 0.005 else r.inactive|pct }}</span></td>
          <td class="num" data-v="{{ r.proj }}" title="Floor {{ r.p10|f1 }} · middle {{ r.p25|f1 }}-{{ r.p75|f1 }} · ceiling {{ r.p90|f1 }}"><div class="proj"><b>{{ r.proj|f1 }}</b>{{ r.range|safe }}<span class="fc">{{ r.p10|f0 }}&ndash;{{ r.p90|f0 }}</span></div></td>
          <td class="num">{{ r.fpg|f1 }}</td>
          <td data-v="{{ {'Must start': 1, 'Start': 2, 'Flex': 3, 'Sit': 4}[r.tier] }}"><span class="tier t-{{ r.tier.split()[0] }}">{{ r.tier }}</span></td>
          <td class="line hide-sm">{{ r.line|safe }}</td>
          <td class="take">{{ r.takeaway }}</td>
        </tr>
        <tr class="detail" hidden><td colspan="10">
          <div class="dgrid">
            <div><div class="dh">This week</div><div class="line">{{ r.line|safe }}</div>
              <div class="muted small" style="margin-top:6px">Floor {{ r.p10|f1 }} &middot; median {{ r.p50|f1 }} &middot; ceiling {{ r.p90|f1 }} &middot; confidence {{ r.conf }}</div></div>
            <div><div class="dh">Season</div><div class="line">{{ r.season|safe }}</div><div class="line" style="margin-top:4px">{{ r.usage|safe }}</div>
              <div class="muted small" style="margin-top:6px">{{ r.fpg|f1 }} FP/G &middot; last 3: {{ r.last3|f1 }}</div></div>
            <div><div class="dh">Points by week</div>{{ r.bars|safe }}</div>
          </div>
        </td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% if block.byes %}<div class="byes"><span>On bye</span>{% for b in block.byes %}<span class="bye">{{ b.logo|safe }}{{ b.name }} <span class="muted">{{ b.fpg|f1 }} FP/G</span></span>{% endfor %}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<section id="tab-games">
  <div class="sec-head"><div><h2>Matchups</h2><p>Model lines next to Vegas. Highlighted edges are where they disagree most.</p></div></div>
  <details class="howto"><summary>How to read</summary><div>
    Model lines come only from opponent-adjusted team ratings (no Vegas inputs), so a disagreement is a genuine second opinion. Spreads use betting notation (favorite minus points).
    Edges appear when the model differs from Vegas by 1+ point on the spread or 1.5+ on the total, and are highlighted at {{ margin_disagree }}+ / {{ total_disagree }}+.
    The bars show each offense against the opposing defense (points per 100 plays vs average): right = the offense has the edge, left = the defense does.
  </div></details>
  <div class="games">
  {% for g in games %}
    <article class="game">
      <div class="g-head">
        <div class="g-team away" style="{{ g.away.row_style }}">{{ g.away.logo|safe }}<div><b>{{ g.away.nick }}</b><small>{{ g.away.qb or g.away.team }}</small></div></div>
        <div class="g-at">{{ 'vs' if g.neutral else '@' }}</div>
        <div class="g-team home" style="{{ g.home.row_style }}">{{ g.home.logo|safe }}<div><b>{{ g.home.nick }}</b><small>{{ g.home.qb or g.home.team }}</small></div></div>
      </div>
      <div class="g-sub"><span>{{ g.kickoff }}{% if g.neutral %} &middot; neutral site{% endif %}</span><span>Model score {{ g.score }}</span></div>
      <div class="g-lines">
        <div class="lb model"><small>Model</small><div class="big">{{ g.model_line }}</div><div class="tot">O/U <b>{{ g.model_total|f1 }}</b></div></div>
        <div class="lb"><small>Vegas</small><div class="big">{{ g.vegas_line }}</div><div class="tot">O/U <b>{{ g.vegas_total|f1 if g.vegas_total == g.vegas_total else 'n/a' }}</b></div></div>
      </div>
      <div class="edges">
        {% for e in g.edges %}<span class="edge{{ ' strong' if e.strong }}">{{ e.label }} <b>&middot; {{ e.value }}</b></span>{% else %}<span class="edge none">Model agrees with Vegas</span>{% endfor %}
      </div>
      <div class="facets">
        <div class="facet-axis"><span></span><span>Offense vs defense</span><span><span>D edge</span><span>O edge</span></span><span></span></div>
        {% for f in g.facets %}
        <div class="facet"><span>{{ (g.away.logo if f.team == g.away.team else g.home.logo)|safe }}</span><span class="lbl">{{ f.label }}</span>{{ f.bar|safe }}<span class="v">{{ f.edge|sgn }}</span></div>
        {% endfor %}
      </div>
      <details><summary>Team ratings</summary>
        <div class="scroll"><table>
          <thead><tr><th></th><th class="num">Pass O</th><th class="num">Run O</th><th class="num">Pass D</th><th class="num">Run D</th><th class="num">ST</th></tr></thead>
          <tbody>{% for s in [g.away, g.home] %}<tr class="teamrow" style="{{ s.row_style }}"><td><b>{{ s.team }}</b></td><td class="num">{{ s.off_pass|sgn }}</td><td class="num">{{ s.off_rush|sgn }}</td><td class="num">{{ s.def_pass|sgn }}</td><td class="num">{{ s.def_rush|sgn }}</td><td class="num">{{ s.st|sgn }}</td></tr>{% endfor %}</tbody>
        </table></div>
      </details>
    </article>
  {% endfor %}
  </div>
</section>

<section id="tab-power">
  <div class="sec-head"><div><h2>Power rankings</h2><p>Opponent-adjusted team strength in points per 100 plays vs an average team, with strength of schedule.</p></div></div>
  <details class="howto"><summary>How to read</summary><div>
    <b>Net</b> = offense + defense + special teams, adjusted for opponents; higher is better everywhere, including defense. <b>Rank range</b> is the 10th-90th percentile rank when ratings are resampled within their uncertainty (200 bootstrap resamples of games): a narrow range means the data has settled, a wide one means a few more games could move the team a lot.
    Colored badges are league ranks (green = top 8, red = bottom 8). <b>Schedule</b>: the average current net rating of opponents already played and still to play (positive = tougher than average; 1st = hardest). Arrows show the move since last week.
  </div></details>
  <div class="card"><div class="scroll"><table class="sortable tiles power">
    <thead><tr><th class="num" data-first="asc">#</th><th data-first="asc">Team</th><th class="num">Net</th><th>Offense</th><th>Defense</th><th class="minor">Pass O</th><th class="minor">Run O</th><th class="minor">Pass D</th><th class="minor">Run D</th><th class="minor">ST</th><th>Schedule played</th><th>Schedule left</th><th class="hide-sm nosort">Trend</th></tr></thead>
    <tbody>
    {% for r in power %}
      <tr class="teamrow" style="{{ r.row_style }}">
        <td class="num rk" data-v="{{ r.rank }}"><span class="rkn">{{ r.rank }}</span>{% if r.move > 0 %}<span class="mv up">&#9650;{{ r.move }}</span>{% elif r.move < 0 %}<span class="mv dn">&#9660;{{ -r.move }}</span>{% else %}<span class="mv">&ndash;</span>{% endif %}</td>
        <td data-v="{{ r.nick }}"><div class="who">{{ r.logo|safe }}<div><b>{{ r.nick }}</b><span class="sub">{{ r.team }} &middot; {{ r.record }}</span></div></div></td>
        <td class="num" data-v="{{ r.net }}"><div class="netc"><b>{{ r.net|sgn }}</b><span class="sub" title="80% of simulations rank this team between {{ r.range.replace('-', ' and ') }} (ratings resampled within their uncertainty). Narrow = settled; wide = a few more games could move them a lot.">rank range {{ r.range }}</span></div></td>
        <td data-v="{{ r.off }}"><div class="mc"><span class="mv2">{{ r.off|sgn }}</span><span class="rk-b {{ r.off_rk|rkc }}">{{ r.off_rk|ord }}</span></div></td>
        <td data-v="{{ r.def }}"><div class="mc"><span class="mv2">{{ r.def|sgn }}</span><span class="rk-b {{ r.def_rk|rkc }}">{{ r.def_rk|ord }}</span></div></td>
        {% for v, k in [(r.off_pass, r.off_pass_rk), (r.off_rush, r.off_rush_rk), (r.def_pass, r.def_pass_rk), (r.def_rush, r.def_rush_rk), (r.st, r.st_rk)] %}
        <td class="minor" data-v="{{ v }}"><div class="mc"><span class="mv3">{{ v|sgn }}</span><span class="rk-b sm {{ k|rkc }}">{{ k|ord }}</span></div></td>
        {% endfor %}
        <td data-v="{{ r.sos_past }}"><div class="mc"><span class="mv2">{{ r.sos_past|sgn }}</span><span class="rk-b rkn2">{{ r.sos_past_rk|ord }}</span></div><span class="sub">{{ 'hard' if r.sos_past_rk <= 8 else 'easy' if r.sos_past_rk >= 25 else 'average' }}</span></td>
        <td data-v="{{ r.sos_next }}"><div class="mc"><span class="mv2">{{ r.sos_next|sgn }}</span><span class="rk-b rkn2">{{ r.sos_next_rk|ord }}</span></div><span class="sub">{{ 'hard' if r.sos_next_rk <= 8 else 'easy' if r.sos_next_rk >= 25 else 'average' }}</span></td>
        <td class="hide-sm">{{ r.spark|safe }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div></div>
</section>

<section id="tab-luck">
  <div class="sec-head"><div><h2>Schedule luck</h2><p>Who has had an easy or hard schedule so far, and what it does to their numbers.</p></div></div>
  <details class="howto"><summary>How to read</summary><div>
    Teams: the gap is how much easier (+) or harder (-) the opponents faced have been than average, in points per 100 plays. Positive = record flattered by the schedule (expect regression).
    Players: fantasy points per game, raw vs adjusted for the defenses faced.
  </div></details>
  <div class="card"><div class="scroll"><table class="sortable tiles">
    <thead><tr><th data-first="asc">Team</th><th class="num">Offense gap</th><th class="num">Defense gap</th><th class="num">Total</th><th class="nosort">Takeaway</th></tr></thead>
    <tbody>{% for r in team_luck %}<tr class="teamrow" style="{{ r.row_style }}"><td data-v="{{ r.team }}"><div class="who">{{ r.logo|safe }}<b>{{ r.team }}</b></div></td>
      <td class="num" title="Raw {{ r.off_raw|sgn }} vs adjusted {{ r.off_adj|sgn }}">{{ r.off_gap|sgn }}</td>
      <td class="num" title="Raw {{ r.def_raw|sgn }} vs adjusted {{ r.def_adj|sgn }}">{{ r.def_gap|sgn }}</td>
      <td class="num" data-v="{{ r.total_gap }}"><span class="valbar">{{ r.total_gap|dbar(8, 90)|safe }}<b>{{ r.total_gap|sgn }}</b></span></td>
      <td class="take">{{ 'Easy schedule so far: likely worse than the record' if r.total_gap > 2 else 'Tough schedule so far: likely better than the record' if r.total_gap < -2 else '' }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
  <div class="card"><div class="scroll"><table class="sortable tiles">
    <thead><tr><th data-first="asc">Player</th><th class="num">G</th><th class="num">Raw FP/G</th><th class="num">Adjusted</th><th class="num">Gap</th><th class="nosort">Takeaway</th></tr></thead>
    <tbody>{% for r in player_luck %}<tr class="teamrow" style="{{ r.row_style }}"><td data-v="{{ r.name }}"><div class="who">{{ r.logo|safe }}<div><b>{{ r.name }}</b><span class="sub">{{ r.pos|posb|safe }} {{ r.team }}</span></div></div></td><td class="num">{{ r.games }}</td><td class="num">{{ r.raw|f1 }}</td><td class="num">{{ r.adj|f1 }}</td>
      <td class="num" data-v="{{ r.gap }}"><span class="valbar">{{ r.gap|dbar(3, 70)|safe }}<b>{{ r.gap|sgn }}</b></span></td><td class="take">{{ r.takeaway if r.gap|abs >= 1 else '' }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<section id="tab-roles">
  <div class="sec-head"><div><h2>Role changes</h2><p>Snap and opportunity spikes in week {{ week - 1 }} compared with each player's previous three games.</p></div></div>
  <details class="howto"><summary>How to read</summary><div>
    Compares each player's latest game with his previous three. Opportunity share = (carries + targets) / team plays. These are alerts, not model inputs: check the reason (injury ahead of him, demotion, game script) before chasing.
  </div></details>
  <div class="card"><div class="scroll"><table class="sortable tiles">
    <thead><tr><th data-first="asc">Player</th><th><abbr title="Sorts by the size of the jump">Snap share</abbr></th><th><abbr title="Sorts by the size of the jump">Opportunity share</abbr></th><th class="num">Touches</th><th class="nosort">Takeaway</th></tr></thead>
    <tbody>{% for r in roles %}<tr class="teamrow" style="{{ r.row_style }}"><td data-v="{{ r.name }}"><div class="who">{{ r.logo|safe }}<div><b>{{ r.name }}</b><span class="sub">{{ r.pos|posb|safe }} {{ r.team }}{% if r.week != week - 1 %} &middot; wk {{ r.week }}{% endif %}</span></div></div></td>
      <td data-v="{{ (r.snap_now or 0) - (r.snap_prev or 0) }}"><span class="arrow"><span class="from">{{ r.snap_prev|pct }}</span><i>&rarr;</i><b>{{ r.snap_now|pct }}</b></span></td>
      <td data-v="{{ (r.opp_now or 0) - (r.opp_prev or 0) }}"><span class="arrow"><span class="from">{{ r.opp_prev|pct }}</span><i>&rarr;</i><b>{{ r.opp_now|pct }}</b></span></td>
      <td class="num">{{ r.touches }}</td><td class="take">{{ r.takeaway }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<section id="tab-model">
  <div class="sec-head"><div><h2>The model</h2><p>How every number on this site is calculated. Blue values are filled in live from this build.</p></div></div>
  {% if model_doc.stale %}<div class="stale">This description may be out of date: the model code or configuration changed after it was last reviewed.</div>{% endif %}
  <div class="doc-layout">
    <nav class="toc">{% for h in model_doc.toc %}<a href="#{{ h.id }}">{{ h.title }}</a>{% endfor %}</nav>
    <article class="card card-pad doc">{{ model_doc.html|safe }}</article>
  </div>
</section>
</div></main>
<footer><div class="wrap">nfl-edge &middot; nflverse, NFL.com practice reports, FantasyPros, Open-Meteo &middot; for entertainment, not betting advice</div></footer>
<script>
document.querySelectorAll('nav.tabs button').forEach(b => b.onclick = () => {
  document.querySelectorAll('nav.tabs button').forEach(x => x.classList.toggle('on', x === b));
  document.querySelectorAll('main section').forEach(s => s.classList.toggle('on', s.id === 'tab-' + b.dataset.tab));
  try { localStorage.setItem('nfledge-tab', b.dataset.tab); } catch (e) {}
  try { history.replaceState(null, '', '#' + b.dataset.tab); } catch (e) {}
});
document.querySelectorAll('.posbar button').forEach(b => b.onclick = () => {
  document.querySelectorAll('.posbar button').forEach(x => x.classList.toggle('on', x === b));
  document.querySelectorAll('.posview').forEach(v => v.hidden = v.dataset.pos !== b.dataset.pos);
});
try {
  const t = location.hash.slice(1) || localStorage.getItem('nfledge-tab');
  const b = t && document.querySelector(`nav.tabs button[data-tab="${t}"]`);
  if (b) b.click();
} catch (e) {}
// Sorting: cells carry their real value in data-v (ranks, percentages, tiers); blanks always sort last; the first
// click uses the header's natural direction (data-first), the next click flips it; detail rows follow their row.
document.querySelectorAll('table.sortable').forEach(tbl => {
  const ths = [...tbl.tHead.rows[tbl.tHead.rows.length - 1].cells];
  const val = (r, i) => {
    const c = r.cells[i]; if (!c) return null;
    let t = c.dataset.v;
    if (t === undefined) t = c.innerText.split(/\r?\n/)[0].replace(/[%+,<]/g, '').trim();
    if (t === '' || t === 'nan' || t === 'None') return null;
    const n = Number(t); return isNaN(n) ? t.toLowerCase() : n;
  };
  ths.forEach((th, i) => {
    if (th.classList.contains('nosort')) return;
    th.classList.add('can-sort');
    th.onclick = () => {
      const dir = th.dataset.dir ? (th.dataset.dir === 'asc' ? 'desc' : 'asc') : (th.dataset.first || 'desc');
      ths.forEach(h => { delete h.dataset.dir; h.classList.remove('sorted-asc', 'sorted-desc'); });
      th.dataset.dir = dir; th.classList.add('sorted-' + dir);
      const m = dir === 'asc' ? 1 : -1, tb = tbl.tBodies[0];
      const mains = [...tb.rows].filter(r => !r.classList.contains('detail'));
      mains.sort((a, b) => {
        const x = val(a, i), y = val(b, i);
        if (x === null || y === null) return x === y ? 0 : x === null ? 1 : -1;
        return (x > y ? 1 : x < y ? -1 : 0) * m;
      });
      mains.forEach(r => {
        const d = r.nextElementSibling && r.nextElementSibling.classList.contains('detail') ? r.nextElementSibling : null;
        tb.appendChild(r); if (d) tb.appendChild(d);
      });
    };
  });
});
document.querySelectorAll('tr.main').forEach(r => r.onclick = () => {
  const d = r.nextElementSibling; if (!d || !d.classList.contains('detail')) return;
  d.hidden = !d.hidden; r.classList.toggle('open', !d.hidden);
});
const ps = document.getElementById('psearch');
if (ps) ps.oninput = () => {
  const q = ps.value.trim().toLowerCase();
  document.querySelectorAll('table.ranks tr.main').forEach(r => {
    const show = !q || r.dataset.name.includes(q); r.hidden = !show;
    const d = r.nextElementSibling; if (d && d.classList.contains('detail') && !show) d.hidden = true;
  });
};
</script>
</body>
</html>
